# 复制此文件为 .env 并填入你的配置
# cp .env.example .env

# 必填：LLM API Key
DETECTOR_LLM_API_KEY=your-api-key-here

# LLM Provider（可选，默认 anthropic）
# 支持: anthropic / openai / deepseek / zhipu / qwen / groq / moonshot / ollama / openai-compatible
DETECTOR_LLM_PROVIDER=anthropic

# LLM Model（可选，每个 provider 有默认模型，见 README）
# DETECTOR_LLM_MODEL=claude-haiku-4-5-20251001

# API Endpoint（可选，自动从 provider 推导）
# DETECTOR_LLM_ENDPOINT=https://api.anthropic.com/v1/messages

# 检测方式: regex / llm / hybrid（可选，默认 regex）
# DETECTOR_DETECTION_METHOD=regex
