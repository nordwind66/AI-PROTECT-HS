{
  "def_version": 1,
  "note": "Declarative description of the upstream rule repositories. `rules.py sources sync --update` resolves the branch to a commit and writes sources.lock.json; `sync --locked` reproduces exactly the locked commit. Add a new entry (and a plugin in tools/sources/) to bring in a fourth rule source -- the engine itself does not change.",
  "sources": [
    {
      "source_id": "atr",
      "name": "agent-threat-rules",
      "display_name": "Agent Threat Rules (ATR)",
      "repo_url": "https://github.com/Agent-Threat-Rule/agent-threat-rules",
      "branch": "main",
      "license_expected": "MIT",
      "license_files": ["LICENSE"],
      "importer": "atr",
      "include_paths": [
        "rules", "spec", "src", "engines", "python", "conformance",
        "ATR-FRAMEWORK-SPEC.md", "ATR-SPEC-v1.md", "CHANGELOG.md", "CITATION.cff",
        "CONTRIBUTING.md", "COVERAGE.md", "DESIGN.md", "LICENSE", "LIMITATIONS.md",
        "README.md", "SPEC.md", "THREAT-MODEL.md", "package.json", "pyproject.toml", "stats.json"
      ],
      "excluded_paths_note": "proposals/ (candidate rules, not published), data/ (corpora, contains a path that is invalid on Windows), docs/, website/, tests/, scripts/, integrations/ are not needed to extract the published rules and are not materialised."
    },
    {
      "source_id": "trans_pid",
      "name": "trans-prompt-injection-detector",
