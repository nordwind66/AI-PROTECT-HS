# Normalise line endings of text, keep the binary rule database / compiled databases untouched.
* text=auto
*.sh text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.sql text eol=lf
*.inc text eol=lf
*.py text eol=lf
*.md text eol=lf
*.ps1 text eol=lf
*.bat text eol=crlf
*.db binary
*.hsdb binary
*.png binary

# the upstream snapshots must be byte-identical to the locked commits (their sha256 are pinned in sources.lock.json)
/third_party/sources/** -text
