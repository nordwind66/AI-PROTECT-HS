{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "prompt-injection-detection-rule",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "category",
      "severity",
      "pattern",
      "description"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^PID-[A-Z]{3}-[0-9]{3}$"
      },
      "name": {
        "type": "string"
      },
      "category": {
        "type": "string",
        "enum": [
          "instruction-override",
          "persona",
          "stealth",
          "exfil",
          "encoding",
          "tr-morphological"
        ]
      },
      "severity": {
        "type": "string",
        "enum": [
          "critical",
          "high",
          "medium",
          "low",
          "info"
        ]
      },
      "lang": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "flags": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "i",
            "m",
            "s",
            "x"
          ]
        }
      },
      "pattern": {
        "type": "string"
      },
      "maps_to": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "false_positive": {
        "type": "string"
      },
      "description": {
        "type": "string"
      }
    },
    "additionalProperties": false
  }
}
