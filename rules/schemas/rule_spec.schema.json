{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-prompt-guard.invalid/schemas/rule_spec.schema.json",
  "title": "Manual rule specification (input of `rules.py add --file`)",
  "description": "A file with one object {\"rules\": [ ... ]} (a top-level array or a single rule object is accepted as well). Every rule becomes origin=manual, gets a stable id AIPS-<CODE>-NNNN and its first revision; its tests are stored as rule_tests. Patterns use the PCRE dialect and are converted / classified (hs_native | hs_prefilter_pcre2) exactly like imported ones; a pattern that cannot be used (empty match, invalid, language-scoped away) rejects the whole file before anything is written.",
  "type": "object",
  "properties": {
    "_comment": { "type": "string" },
    "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rule" } }
  },
  "required": ["rules"],
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["name", "category", "severity", "patterns"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "description": "Unique among manual rules (adding the same name again is a no-op)." },
        "category": { "enum": ["prompt_injection", "jailbreak", "role_spoofing", "instruction_override", "instruction_hijacking",
                               "system_prompt_extraction", "safety_bypass", "obfuscated_injection", "data_exfiltration_instruction"] },
        "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
        "weight": { "type": "number", "minimum": 0, "maximum": 1, "description": "Default by severity: critical 0.85, high 0.70, medium 0.50, low 0.30, info 0.15" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.7 },
        "default_action": { "enum": ["allow", "alert", "review", "block"], "default": "alert" },
        "lang": { "enum": ["zh", "en", "mixed", "any"], "description": "Default: derived from the patterns" },
        "scope": { "enum": ["general", "translation_only", "context_required"], "default": "general" },
        "context_requires": { "type": "object", "minProperties": 1, "additionalProperties": { "type": ["string", "integer", "boolean"] }, "description": "scope=translation_only implies {\"task\": \"translation\"}" },
        "score_group": { "type": ["string", "null"] },
        "description": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "status": { "enum": ["enabled", "disabled"], "default": "enabled" },
        "profile": { "enum": ["fold_v1", "deobf_v1", "trans_v1", "raw_v1"], "default": "fold_v1", "description": "Normalisation applied to the text before the patterns run" },
        "condition": {
          "description": "'any' (default) or 'all' over all patterns, or a condition tree whose leaf ids are the pattern keys",
          "oneOf": [ { "enum": ["any", "all"] }, { "$ref": "#/$defs/condition" } ]
        },
        "patterns": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["regex"],
            "additionalProperties": false,
            "properties": {
              "key": { "type": "string", "description": "Leaf id used by 'condition' (default p1, p2, ...)" },
              "regex": { "type": "string", "minLength": 1 },
              "flags": { "type": "string", "pattern": "^[imsu]*$" },
              "field": { "type": "string", "default": "content", "description": "user_input, content, tool_response, agent_output, agent_message, tool_args, tool_name, tool_description, tool_input" },
              "dialect": { "enum": ["pcre", "py", "es"], "default": "pcre" }
            }
          }
        },
        "tests": {
          "type": "object",
          "additionalProperties": false,
          "description": "Every enabled rule should have at least one positive and one negative sample (`rules.py validate` warns, `--strict` fails).",
          "properties": {
            "positive": { "type": "array", "items": { "type": "string" } },
            "negative": { "type": "array", "items": { "type": "string" } },
            "mixed": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "condition": {
      "oneOf": [
        { "type": "object", "required": ["op", "id"], "additionalProperties": false, "properties": { "op": { "const": "leaf" }, "id": { "type": "string" } } },
        { "type": "object", "required": ["op", "args"], "additionalProperties": false,
          "properties": { "op": { "enum": ["any", "all", "not"] }, "args": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } } } }
      ]
    }
  }
}
