{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "linux-release",
      "displayName": "Linux x86-64, Release (Hyperscan + PCRE2 + SQLite from the system)",
      "description": "Needs libhyperscan-dev, libpcre2-dev, libsqlite3-dev (see scripts/linux/setup_deps.sh). Nothing is installed by the build.",
      "binaryDir": "${sourceDir}/build/linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "APG_WITH_HYPERSCAN": "ON"
      }
    },
    {
      "name": "linux-debug-asan",
      "displayName": "Linux, Debug + AddressSanitizer/UBSan",
      "binaryDir": "${sourceDir}/build/linux-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer"
      }
    },
    {
      "name": "linux-pcre2-fallback",
      "displayName": "Linux, without Hyperscan (explicit pcre2_fallback backend only)",
      "binaryDir": "${sourceDir}/build/linux-fallback",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "APG_WITH_HYPERSCAN": "OFF"
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows x64, Visual Studio 2022 (dependencies via -DCMAKE_PREFIX_PATH or vcpkg toolchain)",
      "description": "Dependencies are located through CMAKE_PREFIX_PATH / HYPERSCAN_ROOT / PCRE2_ROOT; no drive letter is assumed. See docs/windows-build.md.",
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "x64", "strategy": "set" },
      "binaryDir": "${sourceDir}/build/windows",
      "cacheVariables": {
        "APG_WITH_HYPERSCAN": "ON"
      }
    },
    {
      "name": "windows-msvc-fallback",
      "displayName": "Windows x64, Visual Studio 2022, pcre2_fallback backend only (no Hyperscan)",
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "x64", "strategy": "set" },
      "binaryDir": "${sourceDir}/build/windows-fallback",
      "cacheVariables": {
        "APG_WITH_HYPERSCAN": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "linux-release", "configurePreset": "linux-release" },
    { "name": "linux-debug-asan", "configurePreset": "linux-debug-asan" },
    { "name": "linux-pcre2-fallback", "configurePreset": "linux-pcre2-fallback" },
    { "name": "windows-msvc", "configurePreset": "windows-msvc", "configuration": "Release" },
    { "name": "windows-msvc-fallback", "configurePreset": "windows-msvc-fallback", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "linux-release", "configurePreset": "linux-release", "output": { "outputOnFailure": true } },
    { "name": "linux-debug-asan", "configurePreset": "linux-debug-asan", "output": { "outputOnFailure": true } },
    { "name": "linux-pcre2-fallback", "configurePreset": "linux-pcre2-fallback", "output": { "outputOnFailure": true } },
    { "name": "windows-msvc", "configurePreset": "windows-msvc", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "windows-msvc-fallback", "configurePreset": "windows-msvc-fallback", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
